# Step 1: Start
# Step 2: Import the Pandas library
import pandas as pd

# Step 3: Read the .csv or .xls file and create a DataFrame
file_path = "mydata.csv"          # change to your file name (.csv / .xls / .xlsx)

if file_path.endswith(".csv"):
    df = pd.read_csv(file_path)
else:
    df = pd.read_excel(file_path)

# Step 4: Display the first few records using head()
print("First 5 records:")
print(df.head())

# Step 5: Display structure and information using info()
print("\nDataFrame Info:")
df.info()

# Step 6: Display statistical summary using describe()
print("\nStatistical Summary:")
print(df.describe())

# Step 7: Identify missing values in the dataset
print("\nMissing values in each column:")
print(df.isnull().sum())

# Step 8: Handle missing values using dropna() or fillna()
# Option A: fill numeric columns with mean, text columns with mode
for col in df.columns:
    if df[col].dtype == "object":
        df[col] = df[col].fillna(df[col].mode()[0])
    else:
        df[col] = df[col].fillna(df[col].mean())

# Option B: remove rows with missing values (use this instead of Option A if you prefer)
# df = df.dropna()

print("\nMissing values after handling:")
print(df.isnull().sum())

# Step 9: Identify duplicate records using duplicated()
print("\nNumber of duplicate records:", df.duplicated().sum())

# Step 10: Remove duplicate records using drop_duplicates()
df = df.drop_duplicates()
print("Duplicates after removal:", df.duplicated().sum())

# Step 11: Remove irrelevant columns using drop(), if required
# Replace 'column_name' with the column(s) you want to remove
# df = df.drop(columns=["column_name"])

# Step 12: Select and filter required data using loc[]
# Example 1: select specific columns (replace with your column names)
# df = df.loc[:, ["col1", "col2", "col3"]]
# Example 2: filter rows by a condition
# df = df.loc[df["Age"] > 18]

# Step 13: Display the preprocessed DataFrame
print("\nPreprocessed DataFrame:")
print(df)

